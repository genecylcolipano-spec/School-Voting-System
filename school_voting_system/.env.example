APP_NAME="School Voting System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=voting_system
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Passkeys (WebAuthn). RP ID is the host only — no https:// and no path.
PASSKEYS_RELYING_PARTY_ID=localhost
PASSKEYS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PASSKEYS_ALLOWED_AUTH_TYPES=platform
PASSKEYS_ALLOWED_USER_VERIFICATION=preferred

# Public roster registration: passkey enrollment link lifetime (hours)
ENROLLMENT_LINK_EXPIRATION=24
# Self-service "Lost your passkey?" link lifetime (minutes)
PASSKEY_RESET_LINK_EXPIRATION=30
REGISTRATION_MAX_VALIDATION_ATTEMPTS=3
REGISTRATION_VALIDATION_DECAY_MINUTES=60

# For Gmail SMTP on port 587, use MAIL_SCHEME=smtp (Symfony accepts smtp/smtps, not tls)
# Optional legacy key (ignored by this app's config/mail.php): MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PayMongo (GCash / Maya). Amounts are counted only after payment.paid webhook.
# Dashboard: https://dashboard.paymongo.com → Developers
# Webhook URL: ${APP_URL}/webhooks/paymongo
# Subscribe to: checkout_session.payment.paid, payment.paid, payment.failed
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
# PAYMONGO_MIN_AMOUNT=20

# -----------------------------------------------------------------------------
# Laravel Cloud / production — copy these into the Cloud environment, do not
# commit real values. Full walkthrough: LARAVEL_CLOUD.md
#
# Cloud injects APP_KEY, DB_*, and bucket credentials when resources are attached.
# Do not paste your local .env. Use new production mail and PayMongo keys.
#
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-app.laravel.cloud
# APP_TIMEZONE=Asia/Manila
# LOG_LEVEL=warning
# SESSION_ENCRYPT=true
# DB_CONNECTION=mysql
# QUEUE_CONNECTION=database
# CACHE_STORE=database
# SESSION_DRIVER=database
#
# Passkeys must match the live HTTPS host. After adding a custom domain, update
# these three and redeploy or sign-in will fail.
# PASSKEYS_RELYING_PARTY_ID=your-domain.com
# PASSKEYS_ALLOWED_ORIGINS=https://your-domain.com
#
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=
# MAIL_FROM_NAME="${APP_NAME}"
#
# PAYMONGO_SECRET_KEY=
# PAYMONGO_PUBLIC_KEY=
# PAYMONGO_WEBHOOK_SECRET=
#
# Object storage: attach a public Laravel Cloud bucket. Cloud injects AWS_*.
# If AWS_URL is shown on the bucket page but not injected, add it here.
# When AWS_BUCKET is set, the app "public" disk writes to that bucket
# (photos, logos, banners). Leave AWS_BUCKET empty for local XAMPP.
# -----------------------------------------------------------------------------
