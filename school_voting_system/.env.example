APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production checklist:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-school-domain.edu
# SESSION_ENCRYPT=true
# LOG_LEVEL=warning
# MAIL_MAILER=smtp (configure real mail credentials below)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Production: set SESSION_ENCRYPT=true when using HTTPS
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
# Production: use smtp or your school mail provider instead of log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Public roster registration: passkey enrollment link lifetime (hours)
ENROLLMENT_LINK_EXPIRATION=24
# Self-service "Lost your passkey?" link lifetime (minutes)
PASSKEY_RESET_LINK_EXPIRATION=30
REGISTRATION_MAX_VALIDATION_ATTEMPTS=3
REGISTRATION_VALIDATION_DECAY_MINUTES=60

# For Gmail SMTP on port 587, use MAIL_SCHEME=smtp (Symfony accepts smtp/smtps, not tls)
# Optional legacy key (ignored by this app's config/mail.php): MAIL_ENCRYPTION=tls

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
