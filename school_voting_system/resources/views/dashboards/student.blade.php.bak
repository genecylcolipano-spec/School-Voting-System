    @push('scripts')
        <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.2/js/bootstrap.bundle.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const sidebarToggle = document.getElementById('sidebarToggleBtn');
                const shell = document.querySelector('.dashboard-shell');
                const storageKey = 'studentDashboardSidebarCollapsed';

                if (!sidebarToggle || !shell) {
                    return;
                }

                const setCollapsed = (collapsed) => {
                    shell.classList.toggle('sidebar-collapsed', collapsed);
                    sidebarToggle.innerHTML = collapsed ? '<i class="fas fa-chevron-right"></i>' : '<i class="fas fa-chevron-left"></i>';
                    sidebarToggle.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
                    sessionStorage.setItem(storageKey, collapsed ? 'true' : 'false');
                };

                const initialState = sessionStorage.getItem(storageKey) === 'true';
                setCollapsed(initialState);

                sidebarToggle.addEventListener('click', () => {
                    setCollapsed(sessionStorage.getItem(storageKey) !== 'true');
                });
            });
        </script>
    @endpush

